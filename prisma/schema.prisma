// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  problems  Problem[]
  formulas  Formula[]
}

model Problem {
  id           String        @id @default(cuid())
  userId       String
  imageUrl     String // URL to the uploaded problem image
  isUnderstood Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  chatMessages ChatMessage[]
  formulas     Formula[] // Formulas extracted from this problem
}

model ChatMessage {
  id        String   @id @default(cuid())
  problemId String
  role      String // "user" or "ai"
  content   String // The text content of the message
  createdAt DateTime @default(now())
  problem   Problem  @relation(fields: [problemId], references: [id])
}

model Formula {
  id          String   @id @default(cuid())
  userId      String
  problemId   String?
  latex       String // The actual LaTeX representation of the formula
  description String? // Explanation or summary of the formula
  category    String? // e.g., "Algebra", "Geometry", "Trigonometry"
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  problem     Problem? @relation(fields: [problemId], references: [id])
}
